<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo" />
        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#22FFFFFF" />

    <TextView
        android:id="@+id/menuPlay"
        style="@style/LockPlayerMenuItem"
        android:drawableLeft="@drawable/ic_play"
        android:text="@string/menu_play" />
    <TextView
        android:id="@+id/menuQueue"
        style="@style/LockPlayerMenuItem"
        android:drawableLeft="@drawable/ic_queue_add"
        android:text="@string/menu_queue" />
    <TextView
        android:id="@+id/menuDownload"
        style="@style/LockPlayerMenuItem"
        android:drawableLeft="@drawable/ic_download"
        android:text="@string/menu_download" />
</LinearLayout>
